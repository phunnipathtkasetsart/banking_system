# Copy to .env (cp .env.example .env). Values below are for local development only.
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

POSTGRES_DB=digibank
POSTGRES_USER=digibank
POSTGRES_PASSWORD=digibank
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Mongo runs as single-node replica set "rs0" so multi-document transactions work.
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB_NAME=digibank

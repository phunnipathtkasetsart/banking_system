.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/
credentials*.json
docker-compose.override.yml

# ---------------------------------------------------------------
# User uploads (avatars live on local disk, not in git)
# ---------------------------------------------------------------
media/

